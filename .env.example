# Choose which Prisma schema to use: "postgresql" or "mongodb".
# Whenever you change this, run `npm run db:switch` (or just `npm run dev` / `npm run build`,
# which do it automatically) to regenerate the Prisma client for the right provider.
DATABASE_PROVIDER=postgresql

# --- PostgreSQL (Neon) ---
# Neon dashboard -> your project -> Connect -> "Prisma" tab -> copy the connection string.
# Example: postgresql://user:password@ep-xxxx-pooler.neon.tech/dbname?sslmode=require
#
# --- MongoDB (Atlas) ---
# Atlas dashboard -> your cluster -> Connect -> Drivers -> copy the connection string.
# Example: mongodb+srv://user:password@cluster0.mongodb.net/dbname?retryWrites=true&w=majority
#
# Paste whichever one matches DATABASE_PROVIDER above:
DATABASE_URL=

# --- Clerk (authentication) ---
# Create a free app at https://dashboard.clerk.com -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Tells Clerk which routes host the sign-in/sign-up UI, and where to send
# users after either one succeeds. Matches the routes in src/app/.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# --- Resend (transactional email) ---
# Create a free account at https://resend.com -> API Keys.
# Without a verified domain, Resend restricts `from` to onboarding@resend.dev
# and only lets you send to your own Resend account email (sandbox mode).
RESEND_API_KEY=
# Sender address used by every email this app sends. Must be on a domain
# you've verified in Resend (or onboarding@resend.dev while testing).
EMAIL_FROM=
