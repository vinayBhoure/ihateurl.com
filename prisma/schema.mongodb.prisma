// Prisma schema for MongoDB (e.g. MongoDB Atlas).
// This file is copied to prisma/schema.prisma whenever DATABASE_PROVIDER=mongodb.
// Run `npm run db:switch` any time you change DATABASE_PROVIDER in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Example model used by the "Check DB Connection" button on the landing page.
/// Replace this with your real models once the connection is verified.
model Ping {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  message   String
  createdAt DateTime @default(now())
}
