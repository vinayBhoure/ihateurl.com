// Prisma schema for PostgreSQL (e.g. Neon).
// This file is copied to prisma/schema.prisma whenever DATABASE_PROVIDER=postgresql.
// Run `npm run db:switch` any time you change DATABASE_PROVIDER in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Example model used by the "Check DB Connection" button on the landing page.
/// Replace this with your real models once the connection is verified.
model Ping {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
}
